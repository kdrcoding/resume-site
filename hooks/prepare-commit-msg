#!/bin/sh
# Strip injected co-author trailers from automated tooling.
MSG_FILE="$1"
[ -f "$MSG_FILE" ] || exit 0

TMP="${MSG_FILE}.clean"
grep -viE \
  -e 'cursoragent@cursor\.com' \
  -e 'co-authored-by:.*(cursor|claude|openai|chatgpt|copilot)' \
  -e 'made-with:.*(cursor|claude|openai|chatgpt|copilot)' \
  -e 'generated[ -]with.*(cursor|claude|openai|chatgpt|copilot)' \
  "$MSG_FILE" > "$TMP" && mv "$TMP" "$MSG_FILE"

exit 0
